bool loadSnapshotFromJson(const String &payload) {
  DynamicJsonDocument doc(20000);

  DeserializationError err = deserializeJson(doc, payload);
  if (err) {
    Serial.print("Snapshot JSON parse failed: ");
    Serial.println(err.c_str());
    return false;
  }

  allowedTagCount = 0;
  for (JsonVariant v : doc["allowed_tags"].as<JsonArray>()) {
    if (allowedTagCount < MAX_TAGS) {
      String t = v.as<String>();
      t.trim();
      t.toUpperCase();

      if (t.length() > 0) {
        allowedTags[allowedTagCount++] = t;
      }
    }
  }

  sessionCount = 0;
  for (JsonVariant v : doc["active_sessions"].as<JsonArray>()) {
    if (sessionCount < MAX_SESSIONS) {
      String u = v["uuid"].as<String>();
      uint32_t exp = v["expires_at"] | 0;

      u.trim();
      u.toUpperCase();

      if (u.length() > 0) {
        sessions[sessionCount].uuid = u;
        sessions[sessionCount].expires = exp;
        sessionCount++;
      }
    }
  }

  managerCount = 0;
  for (JsonVariant v : doc["manager_uuids"].as<JsonArray>()) {
    if (managerCount < MAX_MANAGERS) {
      String m = v["uuid"].as<String>();
      uint32_t exp = v["expires_at"] | 0;

      m.trim();
      m.toUpperCase();

      if (m.length() > 0) {
        managers[managerCount].uuid = m;
        managers[managerCount].expires = exp;
        managerCount++;
      }
    }
  }

  Serial.println("SNAPSHOT LOADED INTO RAM");
  printSnapshotCache();

  return true;
}

void saveSnapshotToSPIFFS(const String &payload) {
  File f = SPIFFS.open("/snapshot.json", FILE_WRITE);

  if (!f) {
    Serial.println("SPIFFS SAVE FAILED -> could not open snapshot file");
    return;
  }

  f.print(payload);
  f.close();

  Serial.println("SNAPSHOT SAVED TO SPIFFS");
}

bool loadSnapshotFromSPIFFS() {
  if (!SPIFFS.exists("/snapshot.json")) {
    Serial.println("NO LOCAL SNAPSHOT FOUND");
    return false;
  }

  File f = SPIFFS.open("/snapshot.json", FILE_READ);

  if (!f) {
    Serial.println("SPIFFS LOAD FAILED -> could not open snapshot file");
    return false;
  }

  String payload = f.readString();
  f.close();

  if (payload.length() == 0) {
    Serial.println("LOCAL SNAPSHOT EMPTY");
    return false;
  }

  Serial.println("LOADING SNAPSHOT FROM SPIFFS");

  bool ok = loadSnapshotFromJson(payload);

  if (ok) {
    Serial.println("LOCAL SNAPSHOT RESTORED");
  } else {
    Serial.println("LOCAL SNAPSHOT RESTORE FAILED");
  }

  return ok;
}

