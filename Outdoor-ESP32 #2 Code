bool isEntryActive(Entry list[], int count, String uuid) {
  uuid.trim();
  uuid.toUpperCase();

  uint32_t nowEpoch = getCurrentEpoch();

  if (nowEpoch == 0) {
    Serial.println("LOCAL CACHE -> NO VALID TIME");
    return false;
  }

  for (int i = 0; i < count; i++) {
    if (list[i].uuid == uuid) {

      if (list[i].expires == 0) {
        Serial.println("LOCAL CACHE -> UUID FOUND, NO EXPIRY");
        return true;
      }

      if (nowEpoch < list[i].expires) {
        Serial.println("LOCAL CACHE -> UUID FOUND AND ACTIVE");
        return true;
      }

      Serial.println("LOCAL CACHE -> UUID FOUND BUT EXPIRED");
      return false;
    }
  }

  Serial.println("LOCAL CACHE -> UUID NOT FOUND");
  return false;
}

