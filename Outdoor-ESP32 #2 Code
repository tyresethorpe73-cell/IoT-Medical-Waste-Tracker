float readUltrasonicCM() {
  digitalWrite(TRIG_PIN, LOW);
  delayMicroseconds(5);
  digitalWrite(TRIG_PIN, HIGH);
  delayMicroseconds(20);
  digitalWrite(TRIG_PIN, LOW);

  long duration = pulseIn(ECHO_PIN, HIGH, 8000);

  if (duration == 0) return -1;

  float distance = (duration * 0.0343) / 2.0;

  if (distance < 5 || distance > 500) return -1;

  return distance;
}


float smoothDistance(float newVal) {
  static float lastVal = newVal;

  if (newVal < 0) return lastVal;

  lastVal = (lastVal * 0.7) + (newVal * 0.3);
  return lastVal;
}


int calculateFillPercent(float distance) {
  if (distance < 0) return 0;
  if (distance <= FULL_DISTANCE) return 100;
  if (distance >= EMPTY_DISTANCE) return 0;

  float usable = EMPTY_DISTANCE - FULL_DISTANCE;
  float filled = EMPTY_DISTANCE - distance;
  return constrain((filled / usable) * 100, 0, 100);
}

float readBatteryVoltage() {
  long total = 0;

  for (int i = 0; i < 20; i++) {
    total += analogRead(BATTERY_PIN);
    delayMicroseconds(200);
  }

  float raw = total / 20.0;
  float adcVoltage = (raw / 4095.0) * 3.3;

  float batteryVoltage = adcVoltage * 5.682;

  Serial.print("ADC raw = ");
  Serial.print(raw);
  Serial.print(" | ADC V = ");
  Serial.print(adcVoltage, 3);
  Serial.print(" | Batt V = ");
  Serial.println(batteryVoltage, 3);

  return batteryVoltage;
}

int batteryPercent(float v) {

  if (v >= 13.0) return 100;
  if (v >= 12.3) return 100;
  if (v >= 11.8) return 60;
  if (v >= 11.3) return 40;
  if (v >= 10.8) return 20;
  if (v >= 10.0) return 10;

  return 0;
}

float smoothBattery(float newVal) {
    static bool firstRun = true;
    static float lastVal;

    if (firstRun) {
        lastVal = newVal;
        firstRun = false;
        return newVal;
    }

    lastVal = (lastVal * 0.7) + (newVal * 0.3);
    return lastVal;
}

