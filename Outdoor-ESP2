void handleWiFiReconnect() {
  unsigned long now = millis();

  if (now - lastWiFiCheck < WIFI_CHECK_INTERVAL) return;
  lastWiFiCheck = now;

  if (WiFi.status() != WL_CONNECTED) {
    if (wifiWasConnected) {
      Serial.println("WiFi lost. Reconnecting...");
      wifiWasConnected = false;
    }

WiFi.disconnect(false);
WiFi.reconnect();
  } 
  else {
    if (!wifiWasConnected) {
      Serial.println("WiFi reconnected");
      Serial.print("IP → ");
      Serial.println(WiFi.localIP());

      blueUntil = 0;

configTime(GMT_OFFSET, DST_OFFSET, NTP_SERVER);
syncRTCFromNTP();
  
      wifiWasConnected = true;
      fetchSnapshot();
      blueUntil = 0;   
    }
  }
}
void handleOverrideButton() {

    static bool lastState = HIGH;
    static unsigned long lastPressTime = 0;

    bool currentState = digitalRead(OVERRIDE_BTN);

    if (lastState == HIGH && currentState == LOW &&
        millis() - lastPressTime > 300) {

        lastPressTime = millis();

        if (currentMode == MODE_NORMAL) {

            currentMode = MODE_MANAGER_OVERRIDE;
            currentStage = WAITING_FOR_MANAGER;
            stageStartTime = millis();

            ESP1.println("SCAN MANAGER CARD");
            
            Serial.println("Override mode (button) entered");
        }
    }

    lastState = currentState;
}


