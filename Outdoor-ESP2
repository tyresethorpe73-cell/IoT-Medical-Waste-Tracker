int smoothRSSI(int newRSSI) {
  static int lastRSSI = newRSSI;
  lastRSSI = (lastRSSI * 0.7) + (newRSSI * 0.3);
  return lastRSSI;
}

uint8_t rssiToBars(int rssi) {
