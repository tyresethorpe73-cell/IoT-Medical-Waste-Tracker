bool validateAndConsume(String uuid, String tagUID) {

  if (WiFi.status() != WL_CONNECTED) return false;

  IPAddress resolvedIP;
  if (!resolveServerHost(resolvedIP)) return false;

  WiFiClient client;
  HTTPClient http;

  String url = buildServerURL("/bin/consume");

  http.begin(client, url);
  http.addHeader("Content-Type", "application/json");
  http.addHeader("X-API-KEY", SERVER_API_KEY);

  String payload = "{";
  payload += "\"bin_id\":" + String(BIN_ID) + ",";
  payload += "\"uuid\":\"" + uuid + "\",";
  payload += "\"tag_uid\":\"" + tagUID + "\"";
  payload += "}";

  int code = http.POST(payload);

  if (code != 200) {
    http.end();
    return false;
  }

  String response = http.getString();
  http.end();

  DynamicJsonDocument doc(512);
  if (deserializeJson(doc, response)) return false;

  return doc["ok"] == true;
}



void fetchSnapshot() {

  if (WiFi.status() != WL_CONNECTED) return;

  IPAddress resolvedIP;
  if (!resolveServerHost(resolvedIP)) return;

  String url = buildServerURL("/bin/" + String(BIN_ID) + "/snapshot");

  WiFiClient client;
  HTTPClient http;

  http.begin(client, url);
  http.addHeader("X-API-KEY", SERVER_API_KEY);

  int code = http.GET();

  if (code != 200) {
    Serial.print("Snapshot failed: HTTP ");
    Serial.println(code);
    String body = http.getString();
    Serial.println(body);
    http.end();
    return;
  }

  String payload = http.getString();

  if (payload.length() > 19000) {
    Serial.println("Snapshot too large");
    http.end();
    return;
  }

  http.end();

  DynamicJsonDocument doc(20000);
  if (deserializeJson(doc, payload)) {
    Serial.println("JSON parse failed");
    return;
  }

  allowedTagCount = 0;
  for (JsonVariant v : doc["allowed_tags"].as<JsonArray>()) {
    if (allowedTagCount < MAX_TAGS) {
      String t = v.as<String>();
      t.trim();
      t.toUpperCase();
      allowedTags[allowedTagCount++] = t;
    }
  }

  sessionCount = 0;
  for (JsonVariant v : doc["active_sessions"].as<JsonArray>()) {
    if (sessionCount < MAX_SESSIONS) {
      String u = v["uuid"].as<String>();
      uint32_t exp = v["expires_at"] | 0;

      u.trim();
      u.toUpperCase();

      sessions[sessionCount].uuid = u;
      sessions[sessionCount].expires = exp;
      sessionCount++;
    }
  }

  managerCount = 0;
  for (JsonVariant v : doc["manager_uuids"].as<JsonArray>()) {
    if (managerCount < MAX_MANAGERS) {
      String m = v.as<String>();
      m.trim();
      m.toUpperCase();

      managers[managerCount].uuid = m;
      managers[managerCount].expires = 0;
      managerCount++;
    }
  }

  Serial.println("Snapshot Updated");
}

void syncRTCFromNTP() {

if (!rtcAvailable) return;
    if (WiFi.status() != WL_CONNECTED) return;

    Serial.println("Syncing RTC from NTP...");

    struct tm timeinfo;

    if (!getLocalTime(&timeinfo)) {
        Serial.println("NTP failed");
        return;
    }

    DateTime ntpTime(
        timeinfo.tm_year + 1900,
        timeinfo.tm_mon + 1,
        timeinfo.tm_mday,
        timeinfo.tm_hour,
        timeinfo.tm_min,
        timeinfo.tm_sec
    );

    DateTime rtcNow = rtc.now();

long difference = labs((long)ntpTime.unixtime() - (long)rtcNow.unixtime());

    if (difference > 5) {
        rtc.adjust(ntpTime);
        Serial.println("RTC Updated from NTP");
    } else {
        Serial.println("RTC already accurate");
    }

    lastNTPSync = millis();
}

uint32_t parseISOToEpoch(const char* iso) {
  if (!iso) return 0;

  struct tm t;
  memset(&t, 0, sizeof(t));
  strptime(iso, "%Y-%m-%dT%H:%M:%S", &t);
  return (uint32_t)mktime(&t);
}

