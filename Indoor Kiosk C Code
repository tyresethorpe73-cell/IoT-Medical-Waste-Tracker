const unsigned long GREEN_PULSE_DURATION = 50;

// RFID reliability recovery.
// The OLED and MFRC522 share SPI, so if the reader misses scans after screen changes
// or after failed authentication, we periodically re-arm the reader while on RFID screens.
unsigned long lastRFIDRecover = 0;
const unsigned long RFID_RECOVER_INTERVAL_MS = 2000;

void initRFIDKey() {
  for (byte i = 0; i < 6; i++) {
    key.keyByte[i] = 0xFF;
  }
}

bool isRFIDScanState() {
  return currentState == CARD_SCAN_IN ||
         currentState == CARD_SCAN_OUT ||
         currentState == CHECK_CARD ||
         currentState == REGISTER_UID_SCAN;
}

void prepareRFIDForScan() {
  // Make sure OLED is not holding the shared SPI bus before MFRC522 access.
  digitalWrite(OLED_CS, HIGH);
  digitalWrite(RFID_SS, HIGH);

  // Re-arm the reader when entering an RFID screen.
  rfid.PCD_Init();
  rfid.PCD_AntennaOn();
  cleanupRFID();

  lastRFIDRecover = millis();

  Serial.println("RFID ready for scan");
}

void cleanupRFID() {
  // Always release the card/crypto session cleanly after success OR failure.
  // IMPORTANT: do NOT call cleanupRFID() from inside itself.
  // That recursive call caused the ESP32 to reset/boot-loop when entering RFID screens.
  rfid.PICC_HaltA();
  rfid.PCD_StopCrypto1();
  digitalWrite(RFID_SS, HIGH);
}

void serviceRFIDRecovery() {
  if (!isRFIDScanState()) return;

  // If the reader is sitting waiting for a card and becomes quiet/stuck,
  // re-arm it without blocking the main loop.
  if (millis() - lastRFIDRecover >= RFID_RECOVER_INTERVAL_MS) {
    lastRFIDRecover = millis();

    digitalWrite(OLED_CS, HIGH);
    digitalWrite(RFID_SS, HIGH);

    rfid.PCD_StopCrypto1();
    rfid.PCD_AntennaOn();

    Serial.println("RFID re-armed while waiting");
  }
}

void startTimedTransition(unsigned long durationMs, State nextState) {
  timedTransitionStart = millis();
  timedTransitionDuration = durationMs;
  timedTransitionNextState = nextState;
  timedTransitionActive = true;
}

void serviceTimedTransition() {
  if (!timedTransitionActive) return;

  if (millis() - timedTransitionStart >= timedTransitionDuration) {
    timedTransitionActive = false;
    currentState = timedTransitionNextState;
  }
}

void serviceGreenPulse() {
  if (greenPulseActive && millis() - greenPulseStart >= GREEN_PULSE_DURATION) {
    digitalWrite(GREEN_LED, LOW);
    greenPulseActive = false;
  }
}


