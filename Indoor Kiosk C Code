    pendingToken = "";

    if (WiFi.status() != WL_CONNECTED) {
      lastHealthCode = 0;
      lastConnectionStatus = CONN_WIFI_DNS_DOWN;
      showConnectionIssue();
      startTimedTransition(1500, IDLE);
      break;
    }

    IPAddress resolvedIP;
    if (!resolveServerHost(resolvedIP)) {
      lastHealthCode = -1;
      lastConnectionStatus = CONN_WIFI_DNS_DOWN;
      showConnectionIssue();
      startTimedTransition(1500, IDLE);
      break;
    }

    HTTPClient http;
    String url = buildURL("/managers/uuid");

    http.begin(url);
    http.setConnectTimeout(1200);
    http.setTimeout(1200);
    http.addHeader("Content-Type", "application/json");

    StaticJsonDocument<128> doc;
    doc["pin"] = pinBuffer;

    String payload;
    serializeJson(doc, payload);

    Serial.print("MANAGER PREPARE PAYLOAD -> ");
    Serial.println(payload);

    int httpCode = http.POST(payload);
    lastHealthCode = httpCode;

    String body = "";
    if (httpCode > 0) {
      body = http.getString();
    }

    Serial.print("MANAGER PREPARE HTTP -> ");
    Serial.println(httpCode);
    Serial.print("MANAGER PREPARE RESP -> ");
    Serial.println(body);

    if (httpCode <= 0) {
      lastHealthCode = -1;
      lastConnectionStatus = CONN_SERVER_OFFLINE;
      http.end();
      showConnectionIssue();
      startTimedTransition(1500, IDLE);
      break;
    }

    if (httpCode == 409) {
      lastConnectionStatus = CONN_OK;
      http.end();

      oled.clearBuffer();
      oled.drawStr(0, 30, "Credential Exists");
      oled.sendBuffer();

      startTimedTransition(2000, IDLE);
      break;
    }

    if (httpCode == 401) {
      lastConnectionStatus = CONN_OK;
      http.end();

      oled.clearBuffer();
      oled.drawStr(0, 30, "Invalid PIN");
      oled.sendBuffer();

      startTimedTransition(2000, IDLE);
      break;
    }

    if (httpCode != 200) {
      lastConnectionStatus = CONN_SERVER_OFFLINE;
      http.end();

      showConnectionIssue();
      startTimedTransition(1500, IDLE);
      break;
    }

    lastConnectionStatus = CONN_OK;
    pulseGreenLED();

    StaticJsonDocument<384> resp;
    DeserializationError err = deserializeJson(resp, body);
    http.end();

    if (err) {
      Serial.print("MANAGER PREPARE JSON ERROR -> ");
      Serial.println(err.c_str());

      oled.clearBuffer();
      oled.drawStr(0, 20, "Manager Prep");
      oled.drawStr(0, 35, "Bad Response");
      oled.sendBuffer();

      managerEnrollMode = false;
      startTimedTransition(2500, IDLE);
      break;
    }

    sessionUUID  = resp["uuid"].as<String>();
    managerID    = resp["manager_id"].as<String>();
    pendingToken = resp["pending_token"].as<String>();

    if (sessionUUID.length() != 36 || managerID.length() == 0 || pendingToken.length() == 0) {
      Serial.println("Missing manager uuid / manager_id / pending token");

      oled.clearBuffer();
      oled.drawStr(0, 20, "Manager Prep");
      oled.drawStr(0, 35, "Missing Token");
      oled.sendBuffer();

      managerEnrollMode = false;
      startTimedTransition(2500, IDLE);
      break;
    }

    oled.clearBuffer();
    oled.drawStr(0, 20, "Manager PIN OK");
    oled.drawStr(0, 35, "Scan Manager Card");
    oled.sendBuffer();

    startTimedTransition(800, CARD_SCAN_IN);
  }

  break;
