bool syncRTCFromNTP() {
  if (!rtcInitialized) {
    Serial.println("❌ RTC sync skipped: RTC not initialized");
    return false;
  }

  if (WiFi.status() != WL_CONNECTED) {
    Serial.println("❌ RTC sync skipped: WiFi not connected");
    return false;
  }

Serial.println("🌐 Starting NTP sync...");

//  Test if router/repeater DNS can resolve internet NTP server
IPAddress ntpIP;

if (!WiFi.hostByName("pool.ntp.org", ntpIP)) {
  Serial.println("❌ Cannot resolve pool.ntp.org");
  Serial.println("Router DNS/repeater internet is not passing through");
  return false;
}

Serial.print(" pool.ntp.org resolved to: ");
Serial.println(ntpIP);

// Jamaica = UTC -5, no daylight saving time
configTime(-5 * 3600, 0, "pool.ntp.org", "time.nist.gov");

struct tm timeinfo;

  // Keep NTP from freezing the terminal for too long.
  if (!getLocalTime(&timeinfo, 1500)) {
    Serial.println("❌ NTP sync failed");
    Serial.println("Check repeater internet/DNS access");
    return false;
  }

  rtc.adjust(DateTime(
    timeinfo.tm_year + 1900,
    timeinfo.tm_mon + 1,
    timeinfo.tm_mday,
    timeinfo.tm_hour,
    timeinfo.tm_min,
    timeinfo.tm_sec
  ));

  DateTime now = rtc.now();

  Serial.println(" RTC updated from NTP");
  Serial.print("RTC Time: ");
  Serial.print(now.year());
  Serial.print("-");
  Serial.print(now.month());
  Serial.print("-");
  Serial.print(now.day());
  Serial.print(" ");
  Serial.print(now.hour());
  Serial.print(":");
  Serial.print(now.minute());
  Serial.print(":");
  Serial.println(now.second());

  return true;
}

