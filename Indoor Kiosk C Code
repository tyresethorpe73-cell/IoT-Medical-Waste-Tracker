bool commitManagerUUIDWithServer() {

  if (WiFi.status() != WL_CONNECTED) {
    lastHealthCode = 0;
    lastConnectionStatus = CONN_WIFI_DNS_DOWN;
    return false;
  }

  IPAddress resolvedIP;
  if (!resolveServerHost(resolvedIP)) {
    lastHealthCode = -1;
    lastConnectionStatus = CONN_WIFI_DNS_DOWN;
    return false;
  }

  if (managerID.length() == 0 || sessionUUID.length() != 36 || pendingToken.length() == 0) {
    Serial.println("MANAGER COMMIT ERROR -> missing manager_id / uuid / pending token");
    return false;
  }

  HTTPClient http;
  String url = buildURL("/managers/uuid/commit");

  http.begin(url);
  http.setConnectTimeout(1200);
  http.setTimeout(1200);
  http.addHeader("Content-Type", "application/json");

  StaticJsonDocument<256> doc;
  doc["manager_id"] = managerID.toInt();
  doc["uuid"] = sessionUUID;
  doc["pending_token"] = pendingToken;

  String payload;
  serializeJson(doc, payload);

  Serial.print("MANAGER COMMIT PAYLOAD -> ");
  Serial.println(payload);

  int httpCode = http.POST(payload);
  lastHealthCode = httpCode;

  String body = "";
  if (httpCode > 0) {
    body = http.getString();
  }

  http.end();

  Serial.print("MANAGER COMMIT HTTP -> ");
  Serial.println(httpCode);
  Serial.print("MANAGER COMMIT RESP -> ");
  Serial.println(body);

  if (httpCode == 200) {
    lastConnectionStatus = CONN_OK;
    return true;
  }

  if (httpCode <= 0) {
    lastConnectionStatus = CONN_SERVER_OFFLINE;
  } else {
    lastConnectionStatus = CONN_OK;
  }

  return false;
}

