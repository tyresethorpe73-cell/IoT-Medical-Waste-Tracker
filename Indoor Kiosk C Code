String readUUIDFromCard() {

  byte buffer5[18] = {0};
  byte buffer6[18] = {0};
  byte buffer8[18] = {0};
  byte size;

  // ---- Block 5 ----
  size = sizeof(buffer5);
  if (rfid.PCD_Authenticate(MFRC522::PICC_CMD_MF_AUTH_KEY_A, 5, &key, &(rfid.uid)) != MFRC522::STATUS_OK) {
    rfid.PCD_StopCrypto1();
    return "";
  }

  if (rfid.MIFARE_Read(5, buffer5, &size) != MFRC522::STATUS_OK) {
    rfid.PCD_StopCrypto1();
    return "";
  }

  // ---- Block 6 ----
  size = sizeof(buffer6);
  if (rfid.PCD_Authenticate(MFRC522::PICC_CMD_MF_AUTH_KEY_A, 6, &key, &(rfid.uid)) != MFRC522::STATUS_OK) {
    rfid.PCD_StopCrypto1();
    return "";
  }

  if (rfid.MIFARE_Read(6, buffer6, &size) != MFRC522::STATUS_OK) {
    rfid.PCD_StopCrypto1();
    return "";
  }

  // ---- Block 8 ----
  size = sizeof(buffer8);
  if (rfid.PCD_Authenticate(MFRC522::PICC_CMD_MF_AUTH_KEY_A, 8, &key, &(rfid.uid)) != MFRC522::STATUS_OK) {
    rfid.PCD_StopCrypto1();
    return "";
  }

  if (rfid.MIFARE_Read(8, buffer8, &size) != MFRC522::STATUS_OK) {
    rfid.PCD_StopCrypto1();
    return "";
  }

  String uuid = "";

  for (int i = 0; i < 16; i++)
    if (buffer5[i] != 0x00) uuid += (char)buffer5[i];

  for (int i = 0; i < 16; i++)
    if (buffer6[i] != 0x00) uuid += (char)buffer6[i];

for (int i = 0; i < 4; i++)
    if (buffer8[i] != 0x00) uuid += (char)buffer8[i];

  rfid.PCD_StopCrypto1();   // close session cleanly
  return uuid;
}


bool verifyPinWithServer(const char* pin, bool &isManager) {

if (WiFi.status() != WL_CONNECTED) {
  lastServerResult = SERVER_UNREACHABLE;
  lastHealthCode = 0;
  lastConnectionStatus = CONN_WIFI_DNS_DOWN;
  Serial.println("❌ WiFi/DNS down");
  return false;
}

  IPAddress resolvedIP;

if (!resolveServerHost(resolvedIP)) {
  lastServerResult = SERVER_UNREACHABLE;
  lastHealthCode = -1;
  lastConnectionStatus = CONN_WIFI_DNS_DOWN;
  Serial.println("❌ WiFi/DNS down - cannot resolve waste");
  return false;
}

  HTTPClient http;
  String url = buildURL("/auth/pin");

if (url == "") {
  lastServerResult = SERVER_UNREACHABLE;
  lastConnectionStatus = CONN_SERVER_OFFLINE;
  Serial.println("❌ Server URL unavailable");
  return false;
}

  Serial.println("➡️ Contacting server...");

  http.begin(url);
  http.setConnectTimeout(1200);
  http.setTimeout(1200);
  http.addHeader("Content-Type", "application/json");

  StaticJsonDocument<128> doc;
  doc["pin"] = pin;

  String payload;
  serializeJson(doc, payload);

  int httpCode = http.POST(payload);

if (httpCode <= 0) {
  Serial.println("❌ Server offline");
  lastHealthCode = -1;
  lastConnectionStatus = CONN_SERVER_OFFLINE;
  http.end();
  lastServerResult = SERVER_UNREACHABLE;
  return false;
}

  Serial.printf("📡 HTTP code: %d\n", httpCode);
  lastHealthCode = httpCode;
  lastConnectionStatus = CONN_OK;

  if (httpCode == 401) {
    http.end();
    lastServerResult = SERVER_INVALID_PIN;
    return false;
  }

  if (httpCode == 409) {
    http.end();
    lastServerResult = SERVER_ALREADY_CLOCKED_IN;
    return false;
  }

  if (httpCode >= 500) {
    http.end();
    lastServerResult = SERVER_ERROR;
    return false;
  }

  if (httpCode != 200) {
    http.end();
    lastServerResult = SERVER_ERROR;
    return false;
  }

  StaticJsonDocument<384> response;
  DeserializationError err = deserializeJson(response, http.getString());
  http.end();

  if (err) {
    Serial.print("❌ PIN verify JSON parse failed: ");
    Serial.println(err.c_str());
    lastServerResult = SERVER_ERROR;
    return false;
  }

  bool valid = response["valid"] | false;
  const char* role = response["role"] | "";

  if (!valid) {
    Serial.println("❌ Invalid PIN");
    lastServerResult = SERVER_INVALID_PIN;
    return false;
  }

  pulseGreenLED();

  Serial.println("✅ PIN accepted");
  lastServerResult = SERVER_OK;

  isManager = (strcmp(role, "manager") == 0);

  employeeID    = response["employee_id"].as<String>();
  employeeName  = response["employee_name"].as<String>();
  sessionUUID   = response["session_uuid"].as<String>();
  pendingToken  = response["pending_token"].as<String>();

  if (sessionUUID.length() != 36 || pendingToken.length() == 0) {
    Serial.println("❌ Missing session UUID or pending token");
    lastServerResult = SERVER_ERROR;
    return false;
  }

  return true;
}

bool commitClockInWithServer() {

  if (WiFi.status() != WL_CONNECTED) {
    lastHealthCode = 0;
    lastConnectionStatus = CONN_WIFI_DNS_DOWN;
    return false;
  }

  IPAddress resolvedIP;
  if (!resolveServerHost(resolvedIP)) {
    lastHealthCode = -1;
    lastConnectionStatus = CONN_WIFI_DNS_DOWN;
    return false;
  }

  HTTPClient http;
  String url = buildURL("/auth/pin/commit");

  http.begin(url);
  http.setConnectTimeout(1200);
  http.setTimeout(1200);
  http.addHeader("Content-Type", "application/json");

  StaticJsonDocument<256> doc;
  doc["employee_id"] = employeeID.toInt();
  doc["session_uuid"] = sessionUUID;
  doc["pending_token"] = pendingToken;

  String payload;
  serializeJson(doc, payload);

  Serial.print("COMMIT PAYLOAD -> ");
  Serial.println(payload);

  int httpCode = http.POST(payload);
  lastHealthCode = httpCode;

  String body = "";
  if (httpCode > 0) {
    body = http.getString();
  }

  http.end();

  Serial.print("COMMIT HTTP -> ");
  Serial.println(httpCode);
  Serial.print("COMMIT RESP -> ");
  Serial.println(body);

  if (httpCode == 200) {
    lastConnectionStatus = CONN_OK;
    return true;
  }

  if (httpCode <= 0) {
    lastConnectionStatus = CONN_SERVER_OFFLINE;
  } else {
    lastConnectionStatus = CONN_OK;
  }

  return false;
}

bool logClockOutWithServer(const String& uuid) {

  lastClockOutResult = CLOCKOUT_OK;
  lastClockOutMessage = "";

  if (WiFi.status() != WL_CONNECTED) {
    lastHealthCode = 0;
    lastConnectionStatus = CONN_WIFI_DNS_DOWN;
    lastClockOutResult = CLOCKOUT_WIFI_DNS_DOWN;
    lastClockOutMessage = "WiFi/DNS Down";
    Serial.println("❌ Clock-out failed: WiFi/DNS down");
    return false;
  }

  IPAddress resolvedIP;

  if (!resolveServerHost(resolvedIP)) {
    lastHealthCode = -1;
    lastConnectionStatus = CONN_WIFI_DNS_DOWN;
    lastClockOutResult = CLOCKOUT_WIFI_DNS_DOWN;
    lastClockOutMessage = "WiFi/DNS Down";
    Serial.println("❌ Clock-out failed: DNS cannot resolve waste");
    return false;
  }

  HTTPClient http;
  String url = buildURL("/uuid/clock-out");

  Serial.println("🕒 Logging clock-out...");
  Serial.print("URL: ");
  Serial.println(url);

  http.begin(url);
  http.setConnectTimeout(1200);
  http.setTimeout(1200);
  http.addHeader("Content-Type", "application/json");

  StaticJsonDocument<128> doc;
  doc["uuid"] = uuid;

  String payload;
  serializeJson(doc, payload);

  Serial.println("📤 Clock-out payload:");
  Serial.println(payload);

  int httpCode = http.POST(payload);
  lastHealthCode = httpCode;

  String response = http.getString();

  Serial.print("📡 Clock-out HTTP code: ");
  Serial.println(httpCode);
  Serial.println("📥 Clock-out response:");
  Serial.println(response);

  http.end();

  if (httpCode <= 0) {
    lastHealthCode = -1;
    lastConnectionStatus = CONN_SERVER_OFFLINE;
    lastClockOutResult = CLOCKOUT_SERVER_OFFLINE;
    lastClockOutMessage = "Server Offline";
    Serial.printf("❌ Clock-out failed: server unreachable HTTP %d\n", httpCode);
    return false;
  }

  // From here, the server replied, so the server is ONLINE.
  lastConnectionStatus = CONN_OK;

  if (httpCode == 200) {
    lastClockOutResult = CLOCKOUT_OK;
    pulseGreenLED();
    Serial.println("✅ Clock-out recorded");
    return true;
  }

  if (httpCode == 400) {
    lastClockOutResult = CLOCKOUT_BAD_REQUEST;
    lastClockOutMessage = "Bad Card UUID";
    return false;
  }

  if (httpCode == 401 || httpCode == 403) {
    lastClockOutResult = CLOCKOUT_EMPLOYEE_INACTIVE;
    lastClockOutMessage = "Employee Inactive";
    return false;
  }

  if (httpCode == 404) {
    lastClockOutResult = CLOCKOUT_UUID_NOT_FOUND;
    lastClockOutMessage = "UUID Not Found";
    return false;
  }

  if (httpCode == 409) {
    lastClockOutResult = CLOCKOUT_ALREADY_CLOSED;
    lastClockOutMessage = "Already Clocked Out";
    return false;
  }

  if (httpCode >= 500) {
    lastClockOutResult = CLOCKOUT_SERVER_ERROR;
    lastClockOutMessage = "Server Error";
    return false;
  }

  lastClockOutResult = CLOCKOUT_SERVER_ERROR;
  lastClockOutMessage = "Clock-Out Failed";
  return false;
}

bool registerUIDWithServer(const String& uid, const String& bin) {

if (WiFi.status() != WL_CONNECTED) {
  lastHealthCode = 0;
  lastConnectionStatus = CONN_WIFI_DNS_DOWN;
  Serial.println("❌ Tag register failed: WiFi/DNS down");
  showConnectionIssue();
  startTimedTransition(2000, IDLE);
  return false;
}

  IPAddress resolvedIP;

if (!resolveServerHost(resolvedIP)) {
  lastHealthCode = -1;
  lastConnectionStatus = CONN_WIFI_DNS_DOWN;
  Serial.println("❌ Tag register failed: WiFi/DNS down");
  showConnectionIssue();
  startTimedTransition(2000, IDLE);
  return false;
}

  HTTPClient http;
  String url = buildURL("/admin/bag-tags");

if (url == "") {
  lastConnectionStatus = CONN_SERVER_OFFLINE;
  showConnectionIssue();
  startTimedTransition(2000, IDLE);
  return false;
}

  http.begin(url);
  http.setConnectTimeout(1200);
  http.setTimeout(1200);
  http.addHeader("Content-Type", "application/json");

  StaticJsonDocument<256> doc;
  doc["tag_uid"] = uid;

  int streamID = 0;

  switch (bin.toInt()) {
    case 1: streamID = 1; break; // BIO
    case 2: streamID = 6; break; // REC
    case 3: streamID = 2; break; // SHR
    case 4: streamID = 4; break; // PHA
    case 5: streamID = 3; break; // GEN
    default: streamID = 0; break;
  }

  doc["waste_stream_id"] = streamID;

  String payload;
  serializeJson(doc, payload);

  Serial.println("📤 Sending tag registration:");
  Serial.println(payload);

  int httpCode = http.POST(payload);
  lastHealthCode = httpCode;

  Serial.printf("📡 HTTP Code: %d\n", httpCode);

if (httpCode <= 0) {
  lastHealthCode = -1;
  lastConnectionStatus = CONN_SERVER_OFFLINE;
  http.end();

  showConnectionIssue();
  startTimedTransition(1500, IDLE);
  return false;
}

  String response = http.getString();
  Serial.println("📥 Response:");
  Serial.println(response);

  http.end();

lastConnectionStatus = CONN_OK;
if (httpCode == 200) {
  pulseGreenLED();

  oled.clearBuffer();
  oled.setFont(u8g2_font_5x8_tf);

  oled.drawStr(0, 10, "Tag Registered");
  oled.drawHLine(0, 14, 128);

  oled.drawStr(0, 27, "UID saved to server");

  String binText = "Bin: " + bin;
  oled.drawStr(0, 40, binText.c_str());

  oled.drawStr(0, 53, "Ready for use");

  oled.sendBuffer();
  startTimedTransition(2200, IDLE);
  return true;
}

  if (httpCode == 409) {
    oled.clearBuffer();
    oled.drawStr(0, 20, "Tag Already");
    oled.drawStr(0, 35, "Registered");
    oled.sendBuffer();
    startTimedTransition(2000, IDLE);
    return false;
  }

  if (httpCode == 400) {
    oled.clearBuffer();
    oled.drawStr(0, 20, "Bad Request");
    oled.sendBuffer();
    startTimedTransition(2000, IDLE);
    return false;
  }

lastConnectionStatus = CONN_SERVER_OFFLINE;
showConnectionIssue();
startTimedTransition(2000, IDLE);
return false;
}

void pulseGreenLED() {

  if (millis() - lastPulse < 500) return;

  lastPulse = millis();
  greenPulseStart = millis();
  greenPulseActive = true;
  digitalWrite(GREEN_LED, HIGH);
}

void drawWifiBars(int x, int y) {
  bool wifiConnected = (WiFi.status() == WL_CONNECTED);

  if (!wifiConnected) {
    oled.drawFrame(x, y - 6, 10, 6);
    oled.drawLine(x, y - 6, x + 10, y);
    return;
  }

  int rssi = WiFi.RSSI();
  int bars = 0;

  if (rssi > -60) bars = 3;
  else if (rssi > -75) bars = 2;
  else if (rssi > -90) bars = 1;
  else bars = 0;

  if (bars >= 1) oled.drawBox(x,     y - 2, 2, 2);
  if (bars >= 2) oled.drawBox(x + 3, y - 4, 2, 4);
  if (bars >= 3) oled.drawBox(x + 6, y - 6, 2, 6);
}

void drawServerStatusDot(int x, int y) {
  bool serverOnline = (WiFi.status() == WL_CONNECTED && lastConnectionStatus == CONN_OK);

  if (serverOnline) {
    oled.drawDisc(x, y, 2);      // filled circle = server online
  } else {
    oled.drawCircle(x, y, 2);    // empty circle = server offline/unknown
  }
}
