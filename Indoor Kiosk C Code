  }
  stars[shown] = '\0';

  oled.drawStr(40, 25, stars);
}

void handleIdleInput(char key) {

  if (key == 'A') currentState = PIN_ENTRY_EMP;
else if (key == 'B') currentState = CARD_SCAN_OUT;
  else if (key == 'C') currentState = PIN_ENTRY_MGR;
  else if (key == 'D') currentState = CHECK_CARD;
  else if (key == '#') currentState = NETWORK_STATUS;
  else if (key == '0') currentState = REGISTER_UID_SCAN;
}

void handlePinInput(char key) {

  if (key == 0) return;

  if (key >= '0' && key <= '9' && pinIndex < PIN_DIGITS) {

    pinBuffer[pinIndex++] = key;

    if (pinIndex == PIN_DIGITS) {

      pinBuffer[PIN_DIGITS] = '\0';

      if (currentState == PIN_ENTRY_EMP)
        currentState = VERIFY_EMP;

      else if (currentState == PIN_ENTRY_MGR)
        currentState = VERIFY_MGR;
    }

    return;
  }

  if (key == 'C') {
    resetPin();
  }
}


char readKeypad() {
  static char lastKey = 0;

  for (int row = 0; row < 4; row++) {

    // Set all rows HIGH
    for (int i = 0; i < 4; i++) {
      pcf.write(i, HIGH);
    }

    // Drive one row LOW
    pcf.write(row, LOW);

    for (int col = 0; col < 4; col++) {
      if (pcf.read(col + 4) == LOW) {

        char key = keyMap[row][col];

        // Register only NEW press
        if (key != lastKey) {
          lastKey = key;
          return key;
        }

        return 0; // same key still held
      }
    }
  }

  // No key pressed anywhere
  lastKey = 0;
  return 0;
}



void resetPin() {
  memset(pinBuffer, 0, sizeof(pinBuffer));
  pinIndex = 0;
}

