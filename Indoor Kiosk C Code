void loop() {

  //  READ KEYPAD FIRST
  // This allows keypad response even when server/DNS/HTTP is down.
  char pressedKey = readKeypad();

  if (pressedKey != 0) {
    lastActivityTime = millis();
  }

  //  Global back/cancel key
  if (pressedKey == '*') {
    timedTransitionActive = false;
    resetPin();
    sessionUUID = "";
    pendingToken = "";
    employeeID = "";
    employeeName = "";
    scannedUID = "";
    selectedBin = "";
    currentState = IDLE;
  }

  serviceGreenPulse();
  serviceTimedTransition();

  // While a timed message is on screen, keep the display as-is and skip state actions.
  if (timedTransitionActive) {
    return;
  }

  // Only run background network checks on safe screens
  bool canRunNetwork = allowBackgroundNetworkTasks();

  // 🔄 WiFi Reconnect Logic
if (canRunNetwork && WiFi.status() != WL_CONNECTED) {
  if (millis() - lastReconnectAttempt > RECONNECT_INTERVAL) {
    lastReconnectAttempt = millis();

    wl_status_t st = WiFi.status();

    Serial.println("🔄 Attempting WiFi reconnect...");
    Serial.print("WiFi status: ");
    Serial.println(wifiStatusText(st));

    // IMPORTANT:
    // WL_IDLE_STATUS means the ESP is already trying to connect.
    // Do NOT call WiFi.begin() again in that state.
if (st == WL_IDLE_STATUS) {
  Serial.println("⏳ WiFi still connecting... waiting");
}
else if (st == WL_DISCONNECTED) {
  if (millis() - wifiConnectStartedAt < 20000) {
    Serial.println("⏳ Recent connect attempt still settling...");
  } else {
    Serial.println("🔁 Restarting WiFi connection...");
    WiFi.disconnect(false, false);
    wifiConnectStartedAt = millis();
    WiFi.begin(WIFI_SSID, WIFI_PASS);
  }
}
else if (st == WL_CONNECT_FAILED ||
         st == WL_NO_SSID_AVAIL ||
         st == WL_CONNECTION_LOST) {
  Serial.println("🔁 Restarting WiFi connection...");
  WiFi.disconnect(false, false);
  wifiConnectStartedAt = millis();
  WiFi.begin(WIFI_SSID, WIFI_PASS);
}
  }
}

static bool wasConnected = (WiFi.status() == WL_CONNECTED);

bool nowConnected = (WiFi.status() == WL_CONNECTED);

if (canRunNetwork && nowConnected && !wasConnected) {

  Serial.println("✅ WiFi RECONNECTED");

// ✅ Update DS3231 after WiFi returns
rtcSyncedFromNTP = syncRTCFromNTP();
lastRtcSyncAttempt = millis();

}

wasConnected = nowConnected;

// 🕒 Retry RTC sync if WiFi is connected but NTP failed earlier
if (canRunNetwork &&
    rtcInitialized &&
    WiFi.status() == WL_CONNECTED &&
    !rtcSyncedFromNTP &&
    millis() - lastRtcSyncAttempt > RTC_SYNC_RETRY_INTERVAL) {

  Serial.println("🔄 Retrying RTC NTP sync...");

  rtcSyncedFromNTP = syncRTCFromNTP();
  lastRtcSyncAttempt = millis();
}

  // 🔴 Red LED Flash
  // Flashes when WiFi is disconnected OR server is unreachable/down.
if (shouldFlashRedLED()) {

  if (millis() - lastWifiBlink > 500) {
    lastWifiBlink = millis();
    redState = !redState;
    digitalWrite(RED_LED, redState);
  }

} else {
  redState = false;
  digitalWrite(RED_LED, LOW);
}

// 🔍 Periodic server health check
// ✅ Only run when keypad/card flow is idle
if (canRunNetwork && millis() - lastHealthCheck > 5000) {

  lastHealthCheck = millis();

if (WiFi.status() == WL_CONNECTED) {

  IPAddress resolvedIP;

  if (!resolveServerHost(resolvedIP)) {
    lastHealthCode = -1;
    lastConnectionStatus = CONN_WIFI_DNS_DOWN;
  } 
  else {
    HTTPClient http;
    String url = buildURL("/health");

    http.begin(url);
    http.setConnectTimeout(1000);
    http.setTimeout(1000);

    lastHealthCode = http.GET();
    http.end();

    if (lastHealthCode == 200) {
      lastConnectionStatus = CONN_OK;
    } else {
      lastConnectionStatus = CONN_SERVER_OFFLINE;
    }
  }

} else {
  lastHealthCode = 0;
  lastConnectionStatus = CONN_WIFI_DNS_DOWN;
}
}


// ⏳ Inactivity timeout
if (currentState != HOME &&
    millis() - lastActivityTime > INACTIVITY_TIMEOUT)
{
  Serial.println("⏳ Returning to HOME");

  resetPin();
  sessionUUID = "";
  employeeID = "";
  employeeName = "";
  scannedUID = "";
  selectedBin = "";

  currentState = HOME;
}


// ---------- STATE ENTRY / EXIT HANDLING ----------
bool stateChanged = (currentState != lastState);

if (stateChanged) {

  lastActivityTime = millis();

  // ENTERING a PIN state
  if (currentState == PIN_ENTRY_EMP ||
      currentState == PIN_ENTRY_MGR) {

    resetPin();
    pinActive = true;
    verificationDone = false;
  }

  // LEAVING a PIN state
  if (lastState == PIN_ENTRY_EMP ||
      lastState == PIN_ENTRY_MGR) {

    pinActive = false;
  }

  // ENTERING an RFID scan state
  // Draw the waiting screen ONCE, then leave SPI mostly free for MFRC522.
  if (currentState == CARD_SCAN_IN ||
      currentState == CARD_SCAN_OUT ||
      currentState == CHECK_CARD ||
      currentState == REGISTER_UID_SCAN) {

    prepareRFIDForScan();

    oled.clearBuffer();
    oled.setFont(u8g2_font_5x8_tf);

    if (currentState == CARD_SCAN_IN) {
      if (managerEnrollMode) {
        oled.drawStr(0, 20, "Manager Enrolment");
        oled.drawStr(0, 35, "Scan Manager Card");
        oled.drawStr(0, 50, "Ready...");
      } else {
        oled.drawStr(0, 20, "Employee Clock-In");
        oled.drawStr(0, 35, "Scan Employee Card");
        oled.drawStr(0, 50, "Ready...");
      }
    }
    else if (currentState == CARD_SCAN_OUT) {
      oled.drawStr(0, 20, "Scan Card");
      oled.drawStr(0, 35, "to Clock-Out");
    }
    else if (currentState == CHECK_CARD) {
      oled.drawStr(0, 15, "Check Card");
      oled.drawStr(0, 30, "Tap card...");
    }
    else if (currentState == REGISTER_UID_SCAN) {
      oled.drawStr(0, 20, "Scan UID Tag");
      oled.drawStr(0, 35, "Place card...");
    }

    oled.sendBuffer();
  }

  lastState = currentState;
}

if (!isRFIDScanState() && !timedTransitionActive) {
